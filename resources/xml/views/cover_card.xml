<brls:Box
        wireframe="false"
        highlightCornerRadius="8"
        axis="column"
        width="auto"
        height="auto">
    <brls:Box
            id="cover/card/pic_box"
            width="100%"
            height="66%">
        <brls:Image
                id="cover/card/picture"
                backgroundColor="@theme/color/grey_1"
                scalingType="fill"
                height="100%"
                width="100%"
                image="@res/pictures/cover-bg.png"
                cornerRadius="6"/>

        <brls:Box
                positionBottom="0"
                positionType="absolute"
                paddingLeft="10"
                paddingRight="10"
                width="100%"
                height="20%"
                alignItems="center">
            <brls:Label
                    id="cover/card/label/badge"
                    textColor="#FFFFFF"
                    fontSize="15"/>
        </brls:Box>
    </brls:Box>

    <brls:Box
            margin="8"
            axis="column"
            width="auto"
            height="auto">
        <TextBox
                id="cover/card/label/title"
                fontSize="20"
                lineHeight="1.4"
                maxRows="2"
                width="100%"
                height="56"/>
        <brls:Label
                id="cover/card/label/subtitle"
                marginTop="2"
                fontSize="16"
                singleLine="true"
                textColor="@theme/font/grey"
                height="20"/>
    </brls:Box>
</brls:Box>
